---
import {
    Code,
    Database,
    Server,
    Cpu,
    Layers,
    FileCode2,
    Palette,
    LayoutTemplate
} from 'lucide-astro';

const tecnologias = [
    { nombre: 'JS', Icono: Code },
    { nombre: 'C', Icono: Code },
    { nombre: 'C++', Icono: Code },
    { nombre: 'MySQL', Icono: Database },
    { nombre: 'Node.js', Icono: Server },
    { nombre: 'Express', Icono: Cpu },
    { nombre: 'Astro', Icono: Layers },
    { nombre: 'HTML', Icono: FileCode2 },
    { nombre: 'CSS', Icono: Palette },
    { nombre: 'EJS', Icono: LayoutTemplate }
];
---

<section id="tecnologias" class="stack" aria-labelledby="stack-titulo">
    <h2 id="stack-titulo" class="etiqueta">Tecnologías</h2>
    <p class="descripcion">Herramientas que utilizo y sigo explorando</p>
    <ul class="grupo">
        {tecnologias.map((tecnologia) => (
            <li class="tecnologia">
                <div class="circulo">
                    <tecnologia.Icono class="logo-icon" />
                    <span class="nombre-tech">{tecnologia.nombre}</span>
                </div>
            </li>
        ))}
    </ul>
</section>

<style>
    .stack {
        min-width: 0;
    }

    .etiqueta {
        margin: 0 0 0.4rem;
        color: var(--color-3);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .descripcion {
        margin: 0 0 1rem;
        color: var(--color-2);
        font-size: 0.8rem;
    }

    .grupo {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tecnologia {
        min-width: 0;
    }

    .circulo {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        width: 100%;
        min-height: 4rem;
        padding: 0.35rem 0.15rem;
        border: 1px solid transparent;
        border-radius: 0.85rem;
        background:
            linear-gradient(var(--color-5), var(--color-5)) padding-box,
            linear-gradient(135deg, var(--color-3), rgb(167 139 250 / 35%), var(--color-4)) border-box;
        box-shadow: 0 0.35rem 1rem rgb(0 0 0 / 18%);
        transition: box-shadow 0.25s ease, background 0.25s ease;
    }

    .tecnologia:hover .circulo {
        background:
            linear-gradient(rgb(30 27 75 / 88%), rgb(30 27 75 / 88%)) padding-box,
            linear-gradient(135deg, var(--color-2), var(--color-3), var(--color-4)) border-box;
        box-shadow: 0 0.4rem 1.25rem rgb(139 92 246 / 22%);
    }

    .logo-icon {
        width: 1.2rem;
        height: 1.2rem;
        color: var(--color-1);
        flex: 0 0 auto;
        transition: color 0.25s ease;
    }

    .tecnologia:hover .logo-icon {
        color: var(--color-2);
    }

    .nombre-tech {
        font-size: 0.6rem;
        font-weight: 600;
        line-height: 1;
        color: rgb(233 213 255 / 80%);
        letter-spacing: 0.03em;
        transition: color 0.3s ease;
        text-align: center;
        overflow-wrap: anywhere;
    }

    .tecnologia:hover .nombre-tech {
        color: #f3e8ff;
    }

</style>