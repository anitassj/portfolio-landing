---
import { Github, Linkedin, ArrowUpRight, Terminal } from 'lucide-astro';
---

<section id="inicio" class="hero">
    <div class="hero-contenido">
        <div class="hero-texto">
            <div class="badge"><Terminal size={16} /> Técnica Universitaria en Programación · UTN</div>
            <h1>Hola, soy <strong>Ana Luz Ulariaga</strong></h1>
            <h2>Desarrolladora de Software Full Stack y Soluciones Web</h2>
            <p>Me espacializo en desarrollo web con tecnologías modernas y disfruto aprender algo nuevo cada día.
                Mi objetivo es crear experiencias digitales atractivas y funcionales que impacten positivamente en
                la vida de las personas.
            </p>
            <div class="contenedor-botones">
                <a href="#proyectos" class="btn-primario">Ver proyectos <ArrowUpRight size={18} /></a>
                <a href="https://github.com/anitassj" target="_blank" rel="noopener" class="btn-secundario"><Github size={18} />GitHub</a>
                <a href="https://www.linkedin.com/in/ana-luz-ulariaga" target="_blank" rel="noopener" class="btn-secundario"><Linkedin size={18} />LinkedIn</a>
            </div>
        </div>
        <div class="hero-imagen">
            <img src={`${import.meta.env.BASE_URL}/imagenes/principal.png`} alt="Ilustración trabajando en una computadora" fetchpriority="high" />
        </div>
    </div>
</section>

<style>
    .hero {
        max-width: 72rem;
        margin-inline: auto;
        padding: 1.25rem;
    }

    .hero-contenido {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: center;
        gap: 2rem;
    }

    .hero-texto {
        min-width: 0;
        text-align: center;
    }

    .hero-imagen {
        display: flex;
        justify-content: center;
        min-width: 0;
    }

    .hero-imagen img {
        display: block;
        width: min(100%, 34rem);
        height: auto;
        object-fit: contain;
        filter: drop-shadow(0 1rem 2rem rgb(0 0 0 / 25%));
    }

    .contenedor-botones { 
        display: flex; 
        flex-wrap: wrap;
        gap: 1rem; 
        justify-content: center; 
        margin-top: 1.5rem; 
    }

    a { 
        text-decoration: none; 
        padding: 0.75rem 1.5rem; 
        border-radius: 0.375rem; 
        transition: background-color 0.3s, color 0.3s; 
    }

    h1 { 
        color: var(--color-1); 
        font-size: clamp(2rem, 5vw, 3.5rem);
    }

    strong { 
        color: var(--color-3); 
    }

    h2, p { 
        color: var(--color-2); 
    }

    .badge { 
        display: inline-flex; 
        align-items: center; 
        gap: 0.5rem; 
        padding: 0.35rem 0.85rem; 
        background-color: var(--color-4); 
        border: 1px solid var(--color-3); 
        color: var(--color-2); 
        border-radius: 9999px; 
        font-size: 0.875rem; 
        margin-bottom: 1rem; 
    }

    .btn-primario {
        background-color: var(--color-3);
        color: var(--color-1);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primario:hover {
        background-color: var(--color-4);
        transform: translateY(-2px);
    }

    .btn-secundario {
        border: 1px solid var(--color-3);
        color: var(--color-2);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: transform 0.2s ease;
    }

    .btn-secundario:hover {
        background-color: var(--color-3);
        color: var(--color-1);
        transform: translateY(-2px);
    }

    @media (min-width: 768px) {
        .hero-contenido {
            grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
            gap: 2.5rem;
        }

        .hero-texto {
            text-align: left;
        }

        .contenedor-botones {
            justify-content: flex-start;
        }
    }

</style>