---
import { Github, Linkedin, ArrowUpRight, Terminal } from 'lucide-astro';
---

<section class="hero">
    <div class="badge"><Terminal size={16} /> Técnica Universitaria en Programación · UTN</div>
    <h1>Hola, soy <strong>Ana Luz Ulariaga</strong></h1>
    <h2>Desarrolladora de software y soluciones web en formación</h2>
    <p>Me espacializo en desarrollo web con tecnologías modernas y disfruto aprender algo nuevo cada día. 
        Mi objetivo es crear experiencias digitales atractivas y funcionales que impacten positivamente en 
        la vida de las personas.
    </p>
    <div class="contenedor-botones">
        <a href="#proyectos" class="btn-primario">Ver proyectos <ArrowUpRight size={18} /></a>
        <a href="https://github.com/anitassj" target="_blank" rel="noopener" class="btn-secundario"><Github size={18} />GitHub</a>
        <a href="https://www.linkedin.com/in/ana-luz-ulariaga" target="_blank" rel="noopener" class="btn-secundario"><Linkedin size={18} />LinkedIn</a>
    </div>
</section>

<style>
    .hero { 
        padding: 4rem 1rem; 
        text-align: center; 
    }

    .contenedor-botones { 
        display: flex; 
        gap: 1rem; 
        justify-content: center; 
        margin-top: 1.5rem; 
    }

    a { 
        text-decoration: none; 
        padding: 0.75rem 1.5rem; 
        border-radius: 0.375rem; 
        transition: background-color 0.3s, color 0.3s; 
    }

    h1 { 
        color: var(--color-1); 
        /* font-size: 3.5rem; */
    }

    strong { 
        color: var(--color-3); 
    }

    h2, p { 
        color: var(--color-2); 
    }

    .badge { 
        display: inline-flex; 
        align-items: center; 
        gap: 0.5rem; 
        padding: 0.35rem 0.85rem; 
        background-color: var(--color-4); 
        border: 1px solid var(--color-3); 
        color: var(--color-2); 
        border-radius: 9999px; 
        font-size: 0.875rem; 
        margin-bottom: 1rem; 
    }

    .btn-primario {
        background-color: var(--color-3);
        color: var(--color-1);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primario:hover {
        background-color: var(--color-4);
        transform: translateY(-2px);
    }

    .btn-secundario {
        border: 1px solid var(--color-3);
        color: var(--color-2);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: transform 0.2s ease;
    }

    .btn-secundario:hover {
        background-color: var(--color-3);
        color: var(--color-1);
        transform: translateY(-2px);
    }

</style>