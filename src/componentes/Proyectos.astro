---
    import {
        ShoppingBag,
        Code,
        ExternalLink,
        ChevronLeft,
        ChevronRight,
        X
    } from 'lucide-astro';
import EyeAstroComponent from 'lucide-astro/Eye';

const proyectos = [
    {
        id: 'merkatu-pos',
        titulo: 'Sistema POS (Punto de Venta) "Merkatu"',
        descripcion: 'Sistema web de gestión comercial para controlar inventario, registrar ventas y administrar productos, vencimientos, reportes, empleados, caja y etiquetas de precios.',
        tecnologias: ['MySQL', 'Node.js', 'Express', 'JavaScript', 'CSS', 'EJS'],
        icono: 'pos',
        carpetaImagenes: 'merkatu-sistema',
        prefijoImagen: 'merkatu-sistema',
        cantidadImagenes: 18,
        textoImagen: 'Sección',
        repositorio: 'https://github.com/anitassj',
        proyecto: 'https://github.com/anitassj'
    },
    {
        id: 'merkatu-landing',
        titulo: 'Landing page de Merkatu',
        descripcion: 'Landing page creada para presentar y promocionar el sistema POS Merkatu, con información sobre sus funciones, requisitos, precios y formas de contacto.',
        tecnologias: ['Astro', 'HTML', 'CSS', 'JavaScript'],
        icono: 'landing',
        carpetaImagenes: 'merkatu',
        prefijoImagen: 'merkatu',
        cantidadImagenes: 9,
        textoImagen: 'Sección',
        repositorio: 'https://github.com/anitassj',
        proyecto: 'null'
    },
    {
        id: 'prisma-seguros',
        titulo: 'Prisma Seguros',
        descripcion: 'Proyecto final universitario para las materias Metodología de Sistemas I y Laboratorio de Computación IV de la Tecnicatura Universitaria en Programación de la UTN FRSN. El proyecto corresponde un sistema degestión de una aseguradora denominada "Prisma Seguros".',
        tecnologias: ['MySQL', 'Node.js', 'Express', 'JavaScript', 'CSS', 'EJS'],
        icono: 'academico',
        carpetaImagenes: 'prisma',
        prefijoImagen: 'prisma',
        cantidadImagenes: 22,
        textoImagen: 'Sección',
        repositorio: 'https://github.com/anitassj',
        proyecto: null
    }
].map((proyecto) => ({
    ...proyecto,
    dialogId: `galeria-${proyecto.id}`,
    imagenes: Array.from({ length: proyecto.cantidadImagenes }, (_, index) => {
        const src = `${import.meta.env.BASE_URL}/imagenes/${proyecto.carpetaImagenes}/${proyecto.prefijoImagen}-${index + 1}`;
        return {
            src: `${src}.png`,
            srcSet: `${src}-480.jpg 480w, ${src}-960.jpg 960w`,
            alt: `${proyecto.textoImagen} ${index + 1} de ${proyecto.titulo}`
        };
    })
}));
---

<section id="proyectos" class="proyectos">
    <h2>Proyectos</h2>
    <p class="carrusel-ayuda">
        <span class="ayuda-movil">Deslizá para ver los proyectos.</span>
        <span class="ayuda-escritorio">Usá las flechas o deslizá para ver los proyectos.</span>
    </p>
    <div class="carrusel-marco">
        <button type="button" class="carrusel-control carrusel-anterior" aria-label="Proyecto anterior" disabled>
            <ChevronLeft size={24} />
        </button>
        <div
            class="carrusel-proyectos"
            role="region"
            aria-label="Carrusel de proyectos"
            aria-roledescription="carrusel"
            tabindex="0"
        >
            {proyectos.map((proyecto) => (
            <article class="tarjeta" aria-labelledby={`titulo-${proyecto.id}`}>
                <div class="header-tarjeta">
                    {proyecto.icono === 'pos' ? <ShoppingBag size={32} /> : <Code size={32} />}
                    <h3 id={`titulo-${proyecto.id}`}>{proyecto.titulo}</h3>
                </div>
                <p>{proyecto.descripcion}</p>
                {proyecto.tecnologias.length > 0 && (
                    <div class="tags" aria-label="Tecnologías utilizadas">
                        {proyecto.tecnologias.map((tecnologia) => <span>{tecnologia}</span>)}
                    </div>
                )}

                <div class="acciones">
                    {proyecto.repositorio && (
                        <a href={proyecto.repositorio} target="_blank" rel="noopener noreferrer" class="btn-link">
                            Visitar repositorio <ExternalLink size={16} />
                        </a>
                    )}
                    {proyecto.proyecto && (
                        <a href={proyecto.proyecto} target="_blank" rel="noopener noreferrer" class="btn-link">
                            Visitar proyecto <ExternalLink size={16} />
                        </a>
                    )}
                    <button
                        type="button"
                        class="btn-link"
                        aria-haspopup="dialog"
                        aria-controls={proyecto.dialogId}
                        data-dialog-target={proyecto.dialogId}
                    >
                        Vista rápida <EyeAstroComponent size={16} />
                    </button>
                </div> 

                <dialog class="galeria" id={proyecto.dialogId} aria-labelledby={`titulo-${proyecto.dialogId}`}>
                    <div class="galeria-contenido">
                        <header class="galeria-header">
                            <div>
                                
                                <h3 id={`titulo-${proyecto.dialogId}`}>{proyecto.titulo}</h3>
                            </div>
                            <button type="button" class="galeria-cerrar" aria-label="Cerrar galería">
                                <X size={20} />
                            </button>
                        </header>

                        <div class="galeria-visor">
                            {proyecto.imagenes.map((imagen, index) => (
                                <figure
                                    class="galeria-slide"
                                    aria-label={`${index + 1} de ${proyecto.imagenes.length}: ${proyecto.textoImagen} ${index + 1}`}
                                    hidden={index !== 0}
                                >
                                    <picture>
                                        <source
                                            srcset={imagen.srcSet}
                                            sizes="(max-width: 640px) calc(100vw - 3rem), 900px"
                                            type="image/jpeg"
                                        />
                                        <img src={imagen.src} alt={imagen.alt} loading="lazy" decoding="async" />
                                    </picture>
                                    <figcaption>{proyecto.textoImagen} {index + 1}</figcaption>
                                </figure>
                            ))}

                            <button type="button" class="galeria-control galeria-anterior" aria-label="Imagen anterior">
                                <ChevronLeft size={22} />
                            </button>
                            <button type="button" class="galeria-control galeria-siguiente" aria-label="Imagen siguiente">
                                <ChevronRight size={22} />
                            </button>
                        </div>
                        <p class="galeria-contador" aria-live="polite">1 / {proyecto.imagenes.length}</p>
                    </div>
                </dialog>
            </article>
            ))}
        </div>
        <button type="button" class="carrusel-control carrusel-siguiente" aria-label="Proyecto siguiente">
            <ChevronRight size={24} />
        </button>
    </div>
</section>

<style>
    .proyectos {
        padding: 0 1rem 4rem; 
        /* max-width: 1000px; */
        margin: 0 auto; 
    }

    h2 { 
        color: var(--color-1); 
        text-align: center; 
        margin-bottom: 2rem; 
    }

    .carrusel-ayuda {
        margin: -1rem 0 1rem;
        text-align: center;
        font-size: 0.9rem;
        opacity: 0.8;
    }

    .ayuda-movil {
        display: none;
    }

    .carrusel-marco {
        position: relative;
    }

    .carrusel-proyectos {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        padding: 0.25rem 3.25rem 1rem;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: 3.25rem;
        overscroll-behavior-x: contain;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }

    .carrusel-proyectos::-webkit-scrollbar {
        display: none;
    }

    .carrusel-control {
        position: absolute;
        z-index: 1;
        top: 50%;
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        color: var(--color-1);
        background: var(--color-3);
        border: 1px solid var(--color-4);
        border-radius: 50%;
        cursor: pointer;
        transform: translateY(-50%);
        transition: opacity 0.2s ease, background-color 0.2s ease;
    }

    .carrusel-control:hover:not(:disabled) {
        background: var(--color-4);
    }

    .carrusel-control:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .carrusel-control:focus-visible {
        outline: 2px solid var(--color-1);
        outline-offset: 3px;
    }

    .carrusel-anterior {
        left: 0;
    }

    .carrusel-siguiente {
        right: 0;
    }

    /* contenedor de la tarjeta */
    .tarjeta { 
        flex: 0 0 min(100%, 760px);
        box-sizing: border-box;
        background-color: var(--color-5); 
        border: 1px solid var(--color-4); 
        border-radius: 12px; 
        padding: 2rem; 
        transition: border-color 0.3s ease; 
        justify-content: center;
        text-align: center;
        scroll-snap-align: start;
        scroll-snap-stop: always;
    }

    .tarjeta:hover { 
        border-color: var(--color-3); 
    }

    /* contenedor del título */
    .header-tarjeta { 
        display: flex; 
        align-items: center; 
        gap: 1rem; 
        color: var(--color-3); 
        margin-bottom: 1rem; 
        justify-content: center;
    }

    .header-tarjeta h3 { 
        color: var(--color-1); 
        margin: 0; 
    }

    /* tags de tecnologías utilizadas */
    .tags { 
        display: flex; 
        gap: 0.5rem; 
        margin: 1.5rem 0; 
        flex-wrap: wrap; 
        justify-content: center;
    }

    .tags span { 
        display: inline-flex; 
        align-items: center; 
        gap: 0.3rem; 
        background: var(--color-3); 
        color: var(--color-2); 
        padding: 0.25rem 0.75rem; 
        border-radius: 9999px; 
        font-size: 0.85rem; 
    }

    /* botones y links de acciones (ver repo, ver proyecto corriendo, modal de vista rápida) */
    .acciones {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .btn-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: transparent;
        cursor: pointer;
        font-family: inherit;
        color: var(--color-1);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        padding: 0.5rem 1rem;
        border: 1px solid var(--color-4);
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-link:hover {
        border-color: var(--color-3);
        background-color: var(--color-3);
    }

    .btn-link:focus-visible,
    .galeria button:focus-visible {
        outline: 2px solid var(--color-1);
        outline-offset: 3px;
    }

    /* modal para la galería de imagenes del botón 'vista rápida'  */
    .galeria {
        width: min(900px, calc(100% - 2rem));
        max-width: none;
        max-height: min(90vh, 800px);
        padding: 0;
        overflow: auto;
        color: var(--color-1);
        background: var(--color-5);
        border: 1px solid var(--color-4);
        border-radius: 16px;
    }

    .galeria::backdrop {
        backdrop-filter: blur(4px);
    }

    .galeria-contenido {
        padding: clamp(1rem, 4vw, 2rem);
    }

    .galeria-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .galeria-etiqueta {
        margin: 0 0 0.25rem;
        color: var(--color-3);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .galeria-header h3 {
        margin: 0;
        color: var(--color-1);
    }

    .galeria-cerrar,
    .galeria-control {
        display: grid;
        place-items: center;
        color: var(--color-1);
        background: var(--color-5);
        border: 1px solid var(--color-4);
        border-radius: 999px;
        cursor: pointer;
    }

    .galeria-cerrar {
        width: 2.5rem;
        height: 2.5rem;
        flex: 0 0 auto;
    }

    .galeria-visor {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
    }

    .galeria-slide {
        margin: 0;
    }

    .galeria-slide[hidden] {
        display: none;
    }

    .galeria-slide img {
        display: block;
        width: 100%;
        max-height: 65vh;
        object-fit: contain;
    }

    .galeria-slide picture {
        display: block;
    }

    .galeria-slide figcaption {
        padding: 0.75rem 1rem;
        text-align: center;
        font-size: 0.9rem;
    }

    .galeria-control {
        position: absolute;
        top: 50%;
        width: 2.75rem;
        height: 2.75rem;
        transform: translateY(-50%);
    }

    .galeria-control:hover,
    .galeria-cerrar:hover {
        border-color: var(--color-3);
        background: var(--color-3);
    }

    .galeria-anterior {
        left: 0.75rem;
    }

    .galeria-siguiente {
        right: 0.75rem;
    }

    .galeria-contador {
        margin: 0.75rem 0 0;
        text-align: center;
        font-size: 0.85rem;
        opacity: 0.8;
    }

    @media (max-width: 640px) {
        .ayuda-movil {
            display: inline;
        }

        .ayuda-escritorio {
            display: none;
        }

        .carrusel-proyectos {
            padding-inline: 0.25rem;
            scroll-padding-inline: 0.25rem;
        }

        .carrusel-control {
            display: none;
        }

        .tarjeta {
            padding: 1.25rem 1rem;
            text-align: left;
        }

        .header-tarjeta {
            justify-content: flex-start;
        }

        .header-tarjeta h3 {
            font-size: 1.1rem;
        }

        .tags {
            justify-content: flex-start;
            margin: 1.25rem 0;
        }

        .acciones {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }

        .btn-link {
            box-sizing: border-box;
            justify-content: center;
            width: 100%;
            min-height: 44px;
        }

        .galeria {
            width: calc(100% - 1rem);
            max-height: calc(100dvh - 1rem);
            height: calc(100dvh - 1rem);
            border-radius: 12px;
        }

        .galeria-contenido {
            padding: 1rem;
        }

        .galeria-header h3 {
            font-size: 1.1rem;
        }

        .galeria-cerrar {
            width: 2.75rem;
            height: 2.75rem;
        }

        .galeria-slide img {
            max-height: 55dvh;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>('.carrusel-marco').forEach((carousel) => {
        const track = carousel.querySelector<HTMLElement>('.carrusel-proyectos');
        const previousButton = carousel.querySelector<HTMLButtonElement>('.carrusel-anterior');
        const nextButton = carousel.querySelector<HTMLButtonElement>('.carrusel-siguiente');

        if (!track || !previousButton || !nextButton) return;

        const updateControls = () => {
            const maxScroll = track.scrollWidth - track.clientWidth;
            previousButton.disabled = track.scrollLeft <= 1;
            nextButton.disabled = track.scrollLeft >= maxScroll - 1;
        };

        const scrollByCard = (direction: -1 | 1) => {
            const card = track.querySelector<HTMLElement>('.tarjeta');
            if (!card) return;

            const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0;
            track.scrollBy({
                left: direction * (card.getBoundingClientRect().width + gap),
                behavior: 'smooth'
            });
        };

        previousButton.addEventListener('click', () => scrollByCard(-1));
        nextButton.addEventListener('click', () => scrollByCard(1));
        track.addEventListener('scroll', updateControls, { passive: true });
        window.addEventListener('resize', updateControls);
        updateControls();
    });

    document.querySelectorAll<HTMLDialogElement>('.galeria').forEach((dialog) => {
        const slides = Array.from(dialog.querySelectorAll<HTMLElement>('.galeria-slide'));
        const counter = dialog.querySelector<HTMLElement>('.galeria-contador');
        const openButton = document.querySelector<HTMLButtonElement>(
            `[data-dialog-target="${dialog.id}"]`
        );
        const closeButton = dialog.querySelector<HTMLButtonElement>('.galeria-cerrar');
        const previousButton = dialog.querySelector<HTMLButtonElement>('.galeria-anterior');
        const nextButton = dialog.querySelector<HTMLButtonElement>('.galeria-siguiente');
        let currentIndex = 0;

        const showSlide = (index: number) => {
            if (slides.length === 0) return;
            currentIndex = (index + slides.length) % slides.length;
            slides.forEach((slide, slideIndex) => {
                slide.hidden = slideIndex !== currentIndex;
                slide.setAttribute('aria-label', `${slideIndex + 1} de ${slides.length}: ${slide.querySelector('figcaption')?.textContent}`);
            });
            if (counter) counter.textContent = `${currentIndex + 1} / ${slides.length}`;
        };

        showSlide(0);
        openButton?.addEventListener('click', () => {
            showSlide(0);
            dialog.showModal();
        });
        closeButton?.addEventListener('click', () => dialog.close());
        previousButton?.addEventListener('click', () => showSlide(currentIndex - 1));
        nextButton?.addEventListener('click', () => showSlide(currentIndex + 1));
        dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
        });
    });
</script>